      "pattern": "^[0-9a-f]{64}$",
      "title": "Endpoint Response Digest",
      "type": "string"
    },
    "execution_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Execution Id",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "otel_dependencies": {
      "$ref": "#/$defs/HostReadinessFileV1"
    },
    "otel_qualification": {
      "$ref": "#/$defs/HostReadinessFileV1"
