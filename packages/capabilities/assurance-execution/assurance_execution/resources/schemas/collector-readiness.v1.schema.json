      "title": "Schema Version",
      "type": "string"
    },
    "sut_instance_id": {
      "minLength": 1,
      "title": "Sut Instance Id",
      "type": "string"
    },
    "validation_profile": {
      "const": "api_db_trace.v1",
      "title": "Validation Profile",
      "type": "string"
    }
