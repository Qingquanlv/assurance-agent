{
  "$defs": {
    "HostReadinessFileV1": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "digest"
      ],
      "title": "HostReadinessFileV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "T11 must produce this receipt through an authorized host secret handle.\n\nThe endpoint must answer the nonce/execution probe and the host must retain\nthe exact artifact, configuration, dependency and qualification documents.\nMere endpoint liveness does not assert OTel compatibility.",
  "properties": {
    "activity_receipt_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Activity Receipt Digest",
      "type": "string"
    },
    "authorization_scope_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Authorization Scope Digest",
      "type": "string"
    },
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "collector_artifact": {
      "$ref": "#/$defs/HostReadinessFileV1"
    },
    "collector_config": {
      "$ref": "#/$defs/HostReadinessFileV1"
    },
    "collector_endpoint": {
      "title": "Collector Endpoint",
      "type": "string"
    },
    "collector_pid": {
      "exclusiveMinimum": 1,
      "title": "Collector Pid",
      "type": "integer"
    },
    "collector_process_birth_identity": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Collector Process Birth Identity",
      "type": "string"
    },
    "configuration_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Digest",
      "type": "string"
    },
