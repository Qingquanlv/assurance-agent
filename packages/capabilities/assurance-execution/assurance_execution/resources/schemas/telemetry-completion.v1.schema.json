{
  "$defs": {
    "EvidenceArtifactRefV1": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": ["path", "digest"],
      "title": "EvidenceArtifactRefV1",
      "type": "object"
    },
    "StageCompletionV1": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "anyOf": [{"minLength": 1, "type": "string"}, {"type": "null"}],
          "default": null,
          "title": "Reason"
        },
        "receipt_ref": {
          "anyOf": [{"$ref": "#/$defs/EvidenceArtifactRefV1"}, {"type": "null"}],
          "default": null
        },
        "state": {
          "enum": ["complete", "error", "timeout", "incomplete"],
          "title": "State",
          "type": "string"
        }
      },
      "required": ["state"],
      "title": "StageCompletionV1",
      "type": "object"
    },
    "TelemetryArchiveV1": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "path": {
          "const": "telemetry.otlp.jsonl",
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "anyOf": [{"minLength": 1, "type": "string"}, {"type": "null"}],
          "default": null,
          "title": "Reason"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "state": {
          "enum": ["complete", "error", "incomplete"],
          "title": "State",
          "type": "string"
        }
      },
      "required": ["state", "path", "digest", "size"],
      "title": "TelemetryArchiveV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Staged driver/SUT/Collector completion sealed beside telemetry.otlp.jsonl.",
  "properties": {
    "archive": {
      "$ref": "#/$defs/TelemetryArchiveV1"
    },
    "collector_drain": {
      "$ref": "#/$defs/StageCompletionV1"
    },
    "driver_flush": {
      "$ref": "#/$defs/StageCompletionV1"
    },
    "execution_id": {
      "title": "Execution Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "enum": ["complete", "incomplete"],
      "title": "State",
      "type": "string"
    },
    "sut_flush": {
      "$ref": "#/$defs/StageCompletionV1"
    },
    "sut_instance_id": {
      "title": "Sut Instance Id",
      "type": "string"
    }
  },
  "required": [
    "execution_id",
    "sut_instance_id",
    "driver_flush",
    "sut_flush",
    "collector_drain",
    "archive",
    "state"
  ],
  "title": "TelemetryCompletionV1",
  "type": "object"
}
