{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assurance.product/schemas/result-export-v1.json",
  "title": "ResultExportV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "invocation_id",
    "lock_digest",
    "event_stream_digest",
    "result_tree_digest",
    "status",
    "artifact_index"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "invocation_id": { "type": "string", "minLength": 1 },
    "lock_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "event_stream_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "result_tree_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "status": { "$ref": "status-v1.json" },
    "artifact_index": {
      "type": "array",
      "items": { "$ref": "#/$defs/exportedArtifact" }
    }
  },
  "not": {
    "anyOf": [
      { "required": ["secret"] },
      { "required": ["transcript"] },
      { "required": ["chain_of_thought"] }
    ]
  },
  "$defs": {
    "exportedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "relative_path", "media_type", "sha256"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "relative_path": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
