{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AdapterEvidenceRefV1": {
      "additionalProperties": false,
      "properties": {
        "activation_id": {
          "title": "Activation Id",
          "type": "string"
        },
        "activity_id": {
          "title": "Activity Id",
          "type": "string"
        },
        "reference_digest": {
          "title": "Reference Digest",
          "type": "string"
        },
        "terminal_receipt_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Terminal Receipt Digest"
        }
      },
      "required": [
        "activation_id",
        "activity_id",
        "reference_digest",
        "terminal_receipt_digest"
      ],
      "title": "AdapterEvidenceRefV1",
      "type": "object"
    },
    "ApplyProjectionV1": {
      "additionalProperties": false,
      "properties": {
        "manifest_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Manifest Digest"
        },
        "file_count": {
          "minimum": 0,
          "title": "File Count",
          "type": "integer"
        }
      },
      "required": [
        "manifest_digest",
        "file_count"
      ],
      "title": "ApplyProjectionV1",
      "type": "object"
    },
    "ChangeProjectionV1": {
      "additionalProperties": false,
      "properties": {
        "change_id": {
          "title": "Change Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "running",
            "blocked",
            "interrupted",
            "stopped",
            "failed",
            "achieved"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "change_id",
        "state"
      ],
      "title": "ChangeProjectionV1",
      "type": "object"
    },
    "CoverageProgressV1": {
      "additionalProperties": false,
      "properties": {
        "round": {
          "title": "Round",
          "type": "integer"
        },
        "maximum_rounds": {
          "title": "Maximum Rounds",
          "type": "integer"
        },
        "measured": {
          "title": "Measured"
        },
        "decision": {
          "title": "Decision",
          "type": "string"
        }
      },
      "required": [
        "round",
        "maximum_rounds",
        "measured",
        "decision"
      ],
      "title": "CoverageProgressV1",
      "type": "object"
    },
    "EffectStatusV1": {
      "additionalProperties": false,
      "properties": {
        "effect_id": {
          "title": "Effect Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "receipt_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Receipt Digest"
        }
      },
      "required": [
        "effect_id",
        "kind",
        "state",
        "receipt_digest"
      ],
      "title": "EffectStatusV1",
      "type": "object"
    },
    "EvidenceArtifactRefV1": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "path",
        "digest"
      ],
      "title": "EvidenceArtifactRefV1",
      "type": "object"
    },
    "ExecutionGateRefV1": {
      "additionalProperties": false,
      "properties": {
        "semantic_node_id": {
          "enum": [
            "execution.execute",
            "execution.run"
          ],
          "title": "Semantic Node Id",
          "type": "string"
        },
        "batch_id": {
          "minLength": 1,
          "title": "Batch Id",
          "type": "string"
        },
        "execution_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Execution Digest",
          "type": "string"
        }
      },
      "required": [
        "semantic_node_id",
        "batch_id",
        "execution_digest"
      ],
      "title": "ExecutionGateRefV1",
      "type": "object"
    },
    "GraphStatusV1": {
      "additionalProperties": false,
      "properties": {
        "graph_instance_id": {
          "title": "Graph Instance Id",
          "type": "string"
        },
        "graph_id": {
          "title": "Graph Id",
          "type": "string"
        },
        "parent_graph_instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Graph Instance Id"
        },
        "state": {
          "enum": [
            "inactive",
            "running",
            "failed",
            "stopped",
            "interrupted",
            "completed"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "graph_instance_id",
        "graph_id",
        "parent_graph_instance_id",
        "state"
      ],
      "title": "GraphStatusV1",
      "type": "object"
    },
    "InspectionOutcomeV1": {
      "additionalProperties": false,
      "properties": {
        "change_id": {
          "minLength": 1,
          "title": "Change Id",
          "type": "string"
        },
        "coverage_epoch": {
          "minimum": 0,
          "title": "Coverage Epoch",
          "type": "integer"
        },
        "batch_id": {
          "minLength": 1,
          "title": "Batch Id",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "satisfied",
            "coverage_insufficient",
            "repairable_execution_failure",
            "needs_human",
            "blocked"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "inspection_receipt": {
          "$ref": "#/$defs/ReceiptRef"
        },
        "reviewed_case": {
          "$ref": "#/$defs/ReviewedCaseV1"
        },
        "mapping_ref": {
          "$ref": "#/$defs/EvidenceArtifactRefV1"
        },
        "assessment_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceArtifactRefV1"
          },
          "minItems": 1,
          "title": "Assessment Refs",
          "type": "array"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "coverage_state": {
          "anyOf": [
            {
              "enum": [
                "exhausted",
                "inconclusive",
                "needs_human",
                "repair_required",
                "satisfied"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage State"
        }
      },
      "required": [
        "change_id",
        "coverage_epoch",
        "batch_id",
        "disposition",
        "inspection_receipt",
        "reviewed_case",
        "mapping_ref",
        "assessment_refs",
        "reason_codes"
      ],
      "title": "InspectionOutcomeV1",
      "type": "object"
    },
    "NodeStatusV1": {
      "additionalProperties": false,
      "properties": {
        "graph_instance_id": {
          "title": "Graph Instance Id",
          "type": "string"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "inactive",
            "ready",
            "running",
            "retrying",
            "succeeded",
            "failed",
            "stopped",
            "interrupted",
            "skipped"
          ],
          "title": "State",
          "type": "string"
        },
        "attempt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attempt"
        },
        "lease_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lease State"
        },
        "failure_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failure Category"
        },
        "activity_reference_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Activity Reference Digest"
        }
      },
      "required": [
        "graph_instance_id",
        "node_id",
        "state",
        "attempt",
        "lease_state",
        "failure_category",
        "activity_reference_digest"
      ],
      "title": "NodeStatusV1",
      "type": "object"
    },
    "PendingInterruptStatusV1": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "actions": {
          "items": {
            "type": "string"
          },
          "title": "Actions",
          "type": "array"
        },
        "reason_category": {
          "title": "Reason Category",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "actions",
        "reason_category"
      ],
      "title": "PendingInterruptStatusV1",
      "type": "object"
    },
    "PublicationProjectionV1": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "not_ready",
            "ready",
            "published",
            "drifted"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "PublicationProjectionV1",
      "type": "object"
    },
    "QualityGateRefV1": {
      "additionalProperties": false,
      "properties": {
        "inspection": {
          "$ref": "#/$defs/InspectionOutcomeV1"
        },
        "report": {
          "$ref": "#/$defs/ReportOutcomeV1"
        }
      },
      "required": [
        "inspection",
        "report"
      ],
      "title": "QualityGateRefV1",
      "type": "object"
    },
    "ReceiptRef": {
      "additionalProperties": false,
      "properties": {
        "receipt_id": {
          "minLength": 1,
          "title": "Receipt Id",
          "type": "string"
        },
        "receipt_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Receipt Digest",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "receipt_digest"
      ],
      "title": "ReceiptRef",
      "type": "object"
    },
    "ReportOutcomeV1": {
      "additionalProperties": false,
      "properties": {
        "change_id": {
          "minLength": 1,
          "title": "Change Id",
          "type": "string"
        },
        "coverage_epoch": {
          "minimum": 0,
          "title": "Coverage Epoch",
          "type": "integer"
        },
        "batch_id": {
          "minLength": 1,
          "title": "Batch Id",
          "type": "string"
        },
        "inspection_receipt": {
          "$ref": "#/$defs/ReceiptRef"
        },
        "report_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceArtifactRefV1"
          },
          "minItems": 1,
          "title": "Report Refs",
          "type": "array"
        },
        "report_receipt": {
          "$ref": "#/$defs/ReceiptRef"
        }
      },
      "required": [
        "change_id",
        "coverage_epoch",
        "batch_id",
        "inspection_receipt",
        "report_refs",
        "report_receipt"
      ],
      "title": "ReportOutcomeV1",
      "type": "object"
    },
    "ReviewedCaseV1": {
      "additionalProperties": false,
      "properties": {
        "change_id": {
          "minLength": 1,
          "title": "Change Id",
          "type": "string"
        },
        "coverage_epoch": {
          "minimum": 0,
          "title": "Coverage Epoch",
          "type": "integer"
        },
        "preparation_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceArtifactRefV1"
          },
          "minItems": 1,
          "title": "Preparation Refs",
          "type": "array"
        },
        "case_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceArtifactRefV1"
          },
          "minItems": 1,
          "title": "Case Refs",
          "type": "array"
        },
        "review_ref": {
          "$ref": "#/$defs/EvidenceArtifactRefV1"
        }
      },
      "required": [
        "change_id",
        "coverage_epoch",
        "preparation_refs",
        "case_refs",
        "review_ref"
      ],
      "title": "ReviewedCaseV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "invocation_id": {
      "title": "Invocation Id",
      "type": "string"
    },
    "lock_digest": {
      "title": "Lock Digest",
      "type": "string"
    },
    "root_input_digest": {
      "title": "Root Input Digest",
      "type": "string"
    },
    "status": {
      "enum": [
        "running",
        "blocked",
        "interrupted",
        "stopped",
        "failed",
        "completed"
      ],
      "title": "Status",
      "type": "string"
    },
    "entrypoint": {
      "title": "Entrypoint",
      "type": "string"
    },
    "graph_hierarchy": {
      "items": {
        "$ref": "#/$defs/GraphStatusV1"
      },
      "title": "Graph Hierarchy",
      "type": "array"
    },
    "node_states": {
      "items": {
        "$ref": "#/$defs/NodeStatusV1"
      },
      "title": "Node States",
      "type": "array"
    },
    "selected_test_families": {
      "items": {
        "type": "string"
      },
      "title": "Selected Test Families",
      "type": "array"
    },
    "coverage_progress": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoverageProgressV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "durable_effects": {
      "items": {
        "$ref": "#/$defs/EffectStatusV1"
      },
      "title": "Durable Effects",
      "type": "array"
    },
    "adapter_evidence": {
      "items": {
        "$ref": "#/$defs/AdapterEvidenceRefV1"
      },
      "title": "Adapter Evidence",
      "type": "array"
    },
    "execution_gate": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionGateRefV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "quality_gate": {
      "anyOf": [
        {
          "$ref": "#/$defs/QualityGateRefV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "pending_interrupt": {
      "anyOf": [
        {
          "$ref": "#/$defs/PendingInterruptStatusV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "terminal_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Terminal Reason"
    },
    "change": {
      "$ref": "#/$defs/ChangeProjectionV1"
    },
    "apply": {
      "$ref": "#/$defs/ApplyProjectionV1"
    },
    "publication": {
      "$ref": "#/$defs/PublicationProjectionV1"
    }
  },
  "required": [
    "schema_version",
    "invocation_id",
    "lock_digest",
    "root_input_digest",
    "status",
    "entrypoint",
    "graph_hierarchy",
    "node_states",
    "selected_test_families",
    "coverage_progress",
    "durable_effects",
    "adapter_evidence",
    "execution_gate",
    "quality_gate",
    "pending_interrupt",
    "terminal_reason",
    "change",
    "apply",
    "publication"
  ],
  "title": "StatusV1",
  "type": "object"
}
