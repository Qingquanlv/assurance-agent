{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assurance.product/schemas/publish-receipt-v1.json",
  "title": "PublishReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "manifest_digest",
    "source_digest",
    "target_baseline",
    "final_digest",
    "files"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "change_id": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
    "manifest_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "target_baseline": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "final_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/publishFile" }
    }
  },
  "not": {
    "anyOf": [
      { "required": ["secret"] },
      { "required": ["transcript"] },
      { "required": ["chain_of_thought"] },
      { "required": ["result_tree_digest"] },
      { "required": ["destination"] }
    ]
  },
  "$defs": {
    "publishFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_path",
        "source_path",
        "source_sha256",
        "baseline_sha256",
        "final_sha256",
        "temp_name",
        "backup_name"
      ],
      "properties": {
        "target_path": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "source_sha256": { "type": "string", "minLength": 1 },
        "baseline_sha256": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "final_sha256": { "type": "string", "minLength": 1 },
        "temp_name": { "type": "string", "minLength": 1 },
        "backup_name": { "type": "string", "minLength": 1 }
      }
    }
  }
}
