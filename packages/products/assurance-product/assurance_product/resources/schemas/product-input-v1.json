{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assurance.product/schemas/product-input-v1.json",
  "title": "ProductInputV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "requirement",
    "run_mode",
    "candidate_test_families",
    "capability_leafs",
    "capability_catalog",
    "product_policy",
    "data_knowledge",
    "allowed_artifact_paths",
    "budgets"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "change_id": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
    "requirement": { "type": "string", "minLength": 1 },
    "run_mode": { "enum": ["case", "implement", "verify"] },
    "candidate_test_families": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["api", "e2e", "fuzz", "performance"] }
    },
    "resolved_plan_ref": {
      "anyOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "type": "null" }
      ],
      "default": null
    },
    "case_delta_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))qa/cases/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*/case\\.yaml$"
      }
    },
    "capability_leafs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S+\\.\\S+$"
      }
    },
    "capability_catalog": { "$ref": "#/$defs/resourceRef" },
    "product_policy": { "$ref": "#/$defs/resourceRef" },
    "data_knowledge": { "$ref": "#/$defs/resourceRef" },
    "allowed_artifact_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
      }
    },
    "allowed_origins": {
      "type": "array",
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "string",
        "pattern": "^https?://[^/?#]+$"
      }
    },
    "execution_timeout_seconds": {
      "type": "integer",
      "minimum": 31,
      "maximum": 3600,
      "default": 3600
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_rounds", "coverage_rounds", "healing_rounds", "execution_retries"],
      "properties": {
        "review_rounds": { "type": "integer", "minimum": 0 },
        "coverage_rounds": { "type": "integer", "minimum": 0 },
        "healing_rounds": { "type": "integer", "minimum": 0 },
        "execution_retries": { "type": "integer", "minimum": 0 }
      }
    },
    "retro_window": {
      "anyOf": [
        { "$ref": "#/$defs/retroWindow" },
        { "type": "null" }
      ],
      "default": null
    }
  },
  "not": {
    "anyOf": [
      { "required": ["model"] },
      { "required": ["endpoint"] },
      { "required": ["executable"] },
      { "required": ["host"] },
      { "required": ["secret"] },
      { "required": ["auto_archive"] }
    ]
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "resourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "sha256"],
      "properties": {
        "resource_id": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "retroSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["change_ids", "time_range", "last"] },
        "requested_change_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
        "requested_since": { "anyOf": [{ "type": "string" }, { "type": "null" }], "default": null },
        "requested_until": { "anyOf": [{ "type": "string" }, { "type": "null" }], "default": null },
        "requested_last": { "anyOf": [{ "type": "integer" }, { "type": "null" }], "default": null }
      }
    },
    "retroBatchMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_id", "execution_status", "evidence_availability"],
      "properties": {
        "change_id": { "type": "string", "minLength": 1 },
        "execution_status": { "enum": ["completed", "failed", "stopped", "hard_timeout", "cancelled", "running", "not_started"] },
        "evidence_availability": { "enum": ["complete", "partial", "absent"] }
      }
    },
    "retroBatchScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "status"],
      "properties": {
        "schema_version": { "const": "1", "default": "1" },
        "batch_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["complete", "incomplete"] },
        "members": { "type": "array", "items": { "$ref": "#/$defs/retroBatchMember" }, "default": [] }
      }
    },
    "retroWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection", "change_ids"],
      "properties": {
        "selection": { "$ref": "#/$defs/retroSelection" },
        "change_ids": { "type": "array", "items": { "type": "string" } },
        "since": { "anyOf": [{ "type": "string" }, { "type": "null" }], "default": null },
        "until": { "anyOf": [{ "type": "string" }, { "type": "null" }], "default": null },
        "project_event_through": { "anyOf": [{ "type": "string" }, { "type": "null" }], "default": null },
        "batch_scope": { "anyOf": [{ "$ref": "#/$defs/retroBatchScope" }, { "type": "null" }], "default": null }
      }
    }
  }
}
