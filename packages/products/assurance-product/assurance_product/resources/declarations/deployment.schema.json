{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assurance.product/schemas/deployment-bindings-v1.json",
  "title": "DeploymentBindingsV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_plugin_id",
    "adapter_binding",
    "routes",
    "permission_profiles",
    "request_policies",
    "secret_handles"
  ],
  "properties": {
    "validation_profile": { "enum": ["api_db.v1", "api_db_trace.v1", null] },
    "verification_host": {
      "additionalProperties": false,
      "properties": {
        "sut_source_root": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sut Source Root"
        },
        "managed_sut_readiness_handle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Managed Sut Readiness Handle"
        },
        "managed_sut_authority_handle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Managed Sut Authority Handle"
        },
        "credential_handle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Handle"
        },
        "collector_readiness_handle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collector Readiness Handle"
        }
      },
      "title": "VerificationHostConfigV1",
      "type": "object"
    },
    "schema_version": { "const": "1" },
    "runtime_plugin_id": {
      "type": "string",
      "const": "runtime.opencode"
    },
    "adapter_binding": {
      "type": "object",
      "additionalProperties": false
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 32,
      "maxProperties": 32
    },
    "permission_profiles": {
      "type": "object",
      "additionalProperties": false
    },
    "request_policies": {
      "type": "object",
      "additionalProperties": false
    },
    "secret_handles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "not": {
    "anyOf": [
      { "required": ["python"] },
      { "required": ["secret_value"] },
      { "required": ["default_model"] },
      { "required": ["fallback_endpoint"] }
    ]
  }
}
