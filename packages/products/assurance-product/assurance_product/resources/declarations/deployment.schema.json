{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assurance.product/schemas/deployment-bindings-v1.json",
  "title": "DeploymentBindingsV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_plugin_id",
    "adapter_binding",
    "routes",
    "permission_profiles",
    "request_policies",
    "secret_handles"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "runtime_plugin_id": {
      "type": "string",
      "const": "runtime.opencode"
    },
    "adapter_binding": {
      "type": "object",
      "additionalProperties": false
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 34,
      "maxProperties": 34
    },
    "permission_profiles": {
      "type": "object",
      "additionalProperties": false
    },
    "request_policies": {
      "type": "object",
      "additionalProperties": false
    },
    "secret_handles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "not": {
    "anyOf": [
      { "required": ["python"] },
      { "required": ["secret_value"] },
      { "required": ["default_model"] },
      { "required": ["fallback_endpoint"] }
    ]
  }
}
