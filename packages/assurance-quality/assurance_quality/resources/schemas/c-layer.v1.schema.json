{"$defs":{"CLayerMetricEntry":{"additionalProperties":false,"description":"One independent C-layer rate vector.\n\n``evaluated`` requires a positive denominator and a rate that restates the\ntally. ``not_evaluated`` always has ``rate=None``:\n\n- missing feedstock → ``numerator`` / ``denominator`` are ``None`` (never\n  invented zeros)\n- present feedstock with empty denominator → ``0`` / ``0``, still\n  ``not_evaluated``","properties":{"denominator":{"anyOf":[{"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Denominator"},"evidence_digests":{"default":[],"items":{"minLength":1,"type":"string"},"title":"Evidence Digests","type":"array"},"numerator":{"anyOf":[{"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Numerator"},"rate":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"title":"Rate"},"status":{"enum":["evaluated","not_evaluated"],"title":"Status","type":"string"}},"required":["status"],"title":"CLayerMetricEntry","type":"object"}},"additionalProperties":false,"description":"Authoritative report-only C-layer metrics at ``inspect/metrics-c-layer.json``.","properties":{"cadence":{"const":"report","default":"report","title":"Cadence","type":"string"},"change_id":{"minLength":1,"title":"Change Id","type":"string"},"computed_at":{"format":"date-time","title":"Computed At","type":"string"},"counterexample_promotion_rate":{"$ref":"#/$defs/CLayerMetricEntry"},"coverage_gap_closure_rate":{"$ref":"#/$defs/CLayerMetricEntry"},"escape_rate":{"$ref":"#/$defs/CLayerMetricEntry"},"schema_version":{"const":"1","title":"Schema Version","type":"string"},"seed_replay_stability":{"$ref":"#/$defs/CLayerMetricEntry"}},"required":["schema_version","change_id","computed_at","escape_rate","counterexample_promotion_rate","coverage_gap_closure_rate","seed_replay_stability"],"title":"CLayerMetricsDocument","type":"object"}