{"$defs":{"MetricCollectionGap":{"additionalProperties":false,"description":"One reason a metric could not be measured, in the vocabulary a gate reads.\n\nNot a free-text note: a non-empty ``collection_gaps`` is what routes a change\nto needs_human (§6), so every member states which metric it is about and which\nfailure mode it is; only ``detail`` is prose.\n\n``subject`` is what separates the two kinds of gap. Empty means the whole\nmetric failed, and the entry it names must say ``collection_failed``.\nNon-empty names one member of the denominator — an entity, a constraint key,\none artifact — and the rest of the metric stays measurable, so such a gap sits\nbeside an evaluated partial measurement.","properties":{"code":{"enum":["collection_failed","artifact_corrupt","identity_mismatch","entity_without_constraints","property_unknown_key"],"title":"Code","type":"string"},"detail":{"default":"","title":"Detail","type":"string"},"metric":{"enum":["diff_coverage","constraint_coverage","auth_matrix_coverage","journey_coverage","baseline_drift","mutation_score","assertion_strength","threshold_slack","adversarial_yield","adversarial_clean"],"title":"Metric","type":"string"},"subject":{"default":"","title":"Subject","type":"string"}},"required":["code","metric"],"title":"MetricCollectionGap","type":"object"},"MetricShortboard":{"additionalProperties":false,"description":"One metric falling short in a way that reports rather than blocks (§6).","properties":{"code":{"enum":["below_floor","pending_nightly","threshold_slack_out_of_band","baseline_drift_out_of_band","sample_insufficient","mutation_budget_exceeded","adversarial_open","quarantined_excluded"],"title":"Code","type":"string"},"detail":{"default":"","title":"Detail","type":"string"},"metric":{"enum":["diff_coverage","constraint_coverage","auth_matrix_coverage","journey_coverage","baseline_drift","mutation_score","assertion_strength","threshold_slack","adversarial_yield","adversarial_clean"],"title":"Metric","type":"st