[importlinter:contract:graph-engine-provider-neutral]
name = graph engine must not import agent contracts or runtime adapters
type = forbidden
source_modules =
    graph_engine
forbidden_modules =
    agent_runtime_contracts
    agent_runtime_opencode

[importlinter:contract:clients-downward]
name = clients must not import features or products
type = forbidden
