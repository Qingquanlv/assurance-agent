    assurance_improvement.feature

[importlinter:contract:improvement-ops-independent]
name = Improvement ops never import one another
type = independence
modules =
    assurance_improvement.ops.archive
    assurance_improvement.ops.improvement_review
    assurance_improvement.ops.retro
    assurance_improvement.ops.retro_eval_analysis
    assurance_improvement.ops.retro_issue_analysis
    assurance_improvement.ops.retro_workflow_analysis

