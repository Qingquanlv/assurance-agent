[importlinter:contract:generation-ops-below-graphs]
name = Generation ops never import graphs, the plugin, or the feature bundle
type = forbidden
source_modules =
    assurance_generation.ops
forbidden_modules =
    assurance_generation.graphs
    assurance_generation.plugin
    assurance_generation.feature

[importlinter:contract:generation-ops-independent]
name = Generation ops never import one another
type = independence
modules =
    assurance_generation.ops.api_codegen
    assurance_generation.ops.api_codegen_review
    assurance_generation.ops.e2e_codegen
    assurance_generation.ops.e2e_codegen_review
    assurance_generation.ops.fuzz_codegen
    assurance_generation.ops.fuzz_codegen_review
    assurance_generation.ops.performance_codegen
    assurance_generation.ops.performance_codegen_review

[importlinter:contract:generation-graphs-read-op-declarations]
