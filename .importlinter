    assurance_generation.graphs
forbidden_modules =
    assurance_generation.ops.*.hooks
allow_indirect_imports = True

[importlinter:contract:capability-product-no-langgraph]
name = capability and product packages must not import langgraph
type = forbidden
source_modules =
    assurance_intake
    assurance_generation
    assurance_execution
    assurance_healing
    assurance_quality
    assurance_improvement
    assurance_product
forbidden_modules =
    langgraph
ignore_imports =
    assurance_product.sqlite_checkpointer -> langgraph
allow_indirect_imports = True

[importlinter:contract:attempt-runtime-domain-boundary]
name = Attempt runtime routes through its protocol without domain operations
type = forbidden
source_modules =
    graph_engine.attempts.runtime
forbidden_modules =
    graph_engine.attempts.handlers
    graph_engine.attempts.commit
    graph_engine.attempts.workspace
    graph_engine.attempts.resource_arbiter
    graph_engine.persistence
    graph_engine.plugin_api
# The dispatcher reloads full checkpoints through the storage protocol only.
ignore_imports =
    graph_engine.attempts.runtime -> graph_engine.persistence.attempt_checkpoint
# Checkpoint/resolution models may indirectly import shared domain value types.
allow_indirect_imports = True
