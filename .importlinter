[importlinter]
include_external_packages = True
root_packages =
    assurance_intake
    assurance_generation
    assurance_execution
    assurance_healing
    assurance_quality
    assurance_improvement
    graph_engine
    graph_engine_toy_a
    graph_engine_toy_b
    agent_runtime_contracts
    agent_runtime_opencode
    agent_runtime_fixture
    assurance_product

# Permanent boundary: cross-Feature implementation imports remain forbidden.
# Other wheels read only assurance_intake.contracts and assurance_intake.domain.
# Stale exceptions fail lint-imports via its default unmatched-import alert.
[importlinter:contract:generation-intake-contracts-only]
name = generation may import only intake contracts
type = forbidden
source_modules =
    assurance_generation
forbidden_modules =
    assurance_intake.plugin
    assurance_intake.feature
    assurance_intake.ops
    assurance_intake.graphs

[importlinter:contract:execution-assurance-contracts-only]
name = execution may import only intake and generation contracts
type = forbidden
source_modules =
    assurance_execution
forbidden_modules =
    assurance_intake.plugin
    assurance_intake.feature
    assurance_intake.ops
    assurance_intake.graphs
    assurance_generation.plugin
    assurance_generation.operations
    assurance_generation.validators
    assurance_generation.resource_loader
    assurance_generation.resources
    assurance_generation.graphs

[importlinter:contract:healing-assurance-contracts-only]
name = healing may import only intake, generation, and execution contracts
type = forbidden
source_modules =
    assurance_healing
forbidden_modules =
    assurance_intake.plugin
    assurance_intake.feature
    assurance_intake.ops
    assurance_intake.graphs
    assurance_generation.plugin
    assurance_generation.operations
    assurance_generation.validators
    assurance_generation.resource_loader
    assurance_generation.resources
    assurance_generation.graphs
    assurance_execution.plugin
    assurance_execution.operations
    assurance_execution.validators
    assurance_execution.resource_loader
    assurance_execution.resources
    assurance_execution.graphs

[importlinter:contract:healing-no-quality]
name = healing must not import quality
type = forbidden
source_modules =
    assurance_healing
forbidden_modules =
    assurance_quality

[importlinter:contract:quality-assurance-contracts-only]
name = quality may import only intake, generation, execution, and healing contracts
type = forbidden
source_modules =
    assurance_quality
forbidden_modules =
    assurance_intake.plugin
    assurance_intake.feature
    assurance_intake.ops
    assurance_intake.graphs
    assurance_generation.plugin
    assurance_generation.operations
    assurance_generation.validators
    assurance_generation.resource_loader
    assurance_generation.resources
    assurance_generation.graphs
    assurance_execution.plugin
    assurance_execution.operations
    assurance_execution.validators
    assurance_execution.resource_loader
    assurance_execution.resources
    assurance_execution.graphs
    assurance_healing.plugin
    assurance_healing.operations
    assurance_healing.validators
    assurance_healing.resource_loader
    assurance_healing.resources
    assurance_healing.graphs

[importlinter:contract:improvement-assurance-contracts-only]
name = improvement may import only intake, generation, execution, healing, and quality contracts
type = forbidden
source_modules =
    assurance_improvement
forbidden_modules =
    assurance_intake.plugin
    assurance_intake.feature
    assurance_intake.ops
    assurance_intake.graphs
    assurance_generation.plugin
    assurance_generation.operations
    assurance_generation.validators
    assurance_generation.resource_loader
    assurance_generation.resources
    assurance_generation.graphs
    assurance_execution.plugin
    assurance_execution.operations
    assurance_execution.validators
    assurance_execution.resource_loader
    assurance_execution.resources
    assurance_execution.graphs
    assurance_healing.plugin
    assurance_healing.operations
    assurance_healing.validators
    assurance_healing.resource_loader
    assurance_healing.resources
    assurance_healing.graphs
    assurance_quality.plugin
    assurance_quality.operations
    assurance_quality.validators
    assurance_quality.resource_loader
    assurance_quality.resources
    assurance_quality.graphs

[importlinter:contract:features-downward]
name = features must not import concrete clients or product
type = forbidden
source_modules =
    assurance_intake
    assurance_generation
    assurance_execution
    assurance_healing
    assurance_quality
    assurance_improvement
forbidden_modules =
    agent_runtime_opencode
    assurance_product

[importlinter:contract:graph-engine-independent]
name = framework must not import clients, features, products, or fixtures
type = forbidden
source_modules =
    graph_engine
forbidden_modules =
    agent_runtime_contracts
    agent_runtime_opencode
    assurance_intake
    assurance_generation
    assurance_execution
    assurance_healing
    assurance_quality
    assurance_improvement
    assurance_product
    graph_engine_toy_a
    graph_engine_toy_b
    agent_runtime_fixture

[importlinter:contract:graph-engine-provider-neutral]
name = graph engine must not import agent contracts or runtime adapters
type = forbidden
source_modules =
    graph_engine
forbidden_modules =
    agent_runtime_contracts
    agent_runtime_opencode

[importlinter:contract:clients-downward]
name = clients must not import features or products
type = forbidden
source_modules =
    agent_runtime_contracts
    agent_runtime_opencode
forbidden_modules =
    assurance_intake
    assurance_generation
    assurance_execution
    assurance_healing
    assurance_quality
    assurance_improvement
    assurance_product

[importlinter:contract:contracts-wheel-independence]
name = contracts must not import adapters or fixture
type = forbidden
source_modules =
    agent_runtime_contracts
forbidden_modules =
    agent_runtime_opencode
    agent_runtime_fixture

[importlinter:contract:fixture-downward-only]
name = fixture may import graph engine and contracts only
type = forbidden
source_modules =
    agent_runtime_fixture
forbidden_modules =
    agent_runtime_opencode

[importlinter:contract:product-composition-layer]
name = product is the only top-level composition layer
type = forbidden
source_modules =
    graph_engine
    agent_runtime_contracts
    agent_runtime_opencode
    assurance_intake
    assurance_generation
    assurance_execution
    assurance_healing
    assurance_quality
    assurance_improvement
forbidden_modules =
    assurance_product

[importlinter:contract:agent-runtime-contracts-layers]
name = Agent runtime contracts internal layers
type = layers
layers =
    agent_runtime_contracts.executor
    agent_runtime_contracts.ops | agent_runtime_contracts.runtime
    agent_runtime_contracts.wire

[importlinter:contract:intake-domain-pure]
name = Intake domain depends only on intake contracts
type = forbidden
source_modules =
    assurance_intake.domain
forbidden_modules =
    assurance_intake.ops
    assurance_intake.graphs
    assurance_intake.plugin
    assurance_intake.feature

[importlinter:contract:intake-ops-below-graphs]
name = Intake ops never import graphs, the plugin, or the feature bundle
type = forbidden
source_modules =
    assurance_intake.ops
forbidden_modules =
    assurance_intake.graphs
    assurance_intake.plugin
    assurance_intake.feature

[importlinter:contract:intake-ops-independent]
name = Intake ops never import one another
type = independence
modules =
    assurance_intake.ops.case_design
    assurance_intake.ops.case_repair
    assurance_intake.ops.case_review
    assurance_intake.ops.coverage_rework
    assurance_intake.ops.explore
    assurance_intake.ops.intake
    assurance_intake.ops.resolve_plan

[importlinter:contract:intake-graphs-read-op-declarations]
name = Intake graphs read op declarations, never op hooks or models
type = forbidden
source_modules =
    assurance_intake.graphs
forbidden_modules =
    assurance_intake.ops.*.hooks
    assurance_intake.ops.*.models
allow_indirect_imports = True

[importlinter:contract:quality-ops-below-graphs]
name = Quality ops never import graphs, the plugin, or the feature bundle
type = forbidden
source_modules =
    assurance_quality.ops
forbidden_modules =
    assurance_quality.graphs
    assurance_quality.plugin
    assurance_quality.feature

[importlinter:contract:quality-ops-independent]
name = Quality ops never import one another
type = independence
modules =
    assurance_quality.ops.fact_baseline
    assurance_quality.ops.inspect
    assurance_quality.ops.issue_analysis
    assurance_quality.ops.issue_triage
    assurance_quality.ops.report

[importlinter:contract:quality-graphs-read-op-declarations]
name = Quality graphs read op declarations, never op hooks
type = forbidden
source_modules =
    assurance_quality.graphs
forbidden_modules =
    assurance_quality.ops.*.hooks
allow_indirect_imports = True

[importlinter:contract:healing-ops-below-graphs]
