{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aa.local/schemas/explore-advisory.schema.json",
  "title": "ExploreAdvisory",
  "type": "object",
  "required": [
    "schema_version",
    "change_id",
    "context_ref",
    "generated_at",
    "executive_summary",
    "watchlist",
    "case_design_guidance",
    "open_questions_for_case_design"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "change_id": { "type": "string" },
    "context_ref": { "type": "string" },
    "watchlist": { "type": "array" },
    "source_code_evidence": {
      "description": "Source-structure facts collected by Explore. These facts are advisory-owned and must never be appended to the CLI-owned context.json.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "type", "description", "parse_confidence_cap"],
        "properties": {
          "id": { "type": "string", "pattern": "^SC-[A-Z0-9-]+$" },
          "source": { "const": "source_code" },
          "type": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "parse_confidence_cap": { "type": "string", "enum": ["medium", "low"] },
          "module": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "case_design_guidance": {
      "description": "Evidence-anchored guidance for aa-case-design. priority_hints is the sole channel for risk-area signals (formerly split into a separate hotspots array) — every priority_hint now carries its own confidence, same as watchlist items.",
      "type": "object",
      "properties": {
        "priority_hints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "hint", "confidence", "evidence_ids"],
            "properties": {
              "id": { "type": "string", "pattern": "^PH-\\d+$" },
              "hint": { "type": "string" },
              "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
              "evidence_ids": { "type": "array", "items": { "type": "string" } },
              "source_basis": { "type": "string" },
              "case_id": { "type": "string" },
              "open_question_ref": {
                "description": "OQ-* id whose assertion_intent decision this hint propagates. Required when assertion_intent is set.",
                "type": "string",
                "pattern": "^OQ-\\d+$"
              },
              "assertion_intent": {
                "description": "Propagated from open_questions_for_case_design after Step 5. Tells case-design what to assert for this pitfall — must align with the linked OQ answer. Omit on draft hints until Step 5 reconciliation; remove the entire hint when OQ decision is ignore.",
                "oneOf": [
                  { "type": "string", "enum": ["assert_known_bug", "assert_ideal", "ignore", "undecided"] },
                  { "type": "null" }
                ]
              }
            }
          }
        },
        "suggested_scenarios": {
          "description": "Case-ready scenarios derived from priority_hints. Each MUST add concrete execution detail beyond its PH (input value, asserted status/field, or precondition) — do not restate the hint. One priority_hint may fan out into multiple scenarios along distinct input/assertion dimensions.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "evidence_ids": { "type": "array", "items": { "type": "string" } },
              "priority_hint_ref": { "type": "string", "pattern": "^PH-\\d+$" }
            }
          }
        },
        "regression_focus": { "type": "array" }
      }
    },
    "test_strategy": {
      "description": "Macro test plan proposal (scope/data/layer/approach) derived from evidence. This is a PROPOSAL for aa-case-design to confirm/adjust during its own clarifying questions — it is never asked as an explore open_question.",
      "type": "object",
      "properties": {
        "scope": {
          "type": "object",
          "properties": {
            "in_scope": { "type": "array", "items": { "type": "string" } },
            "out_of_scope": { "type": "array", "items": { "type": "string" } }
          }
        },
        "data_focus": { "type": "array", "items": { "type": "string" } },
        "layer_recommendation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["layer", "recommended"],
            "properties": {
              "layer": { "type": "string", "enum": ["API", "E2E", "Fuzz", "Performance"] },
              "recommended": { "type": "boolean" },
              "depth": { "type": "string", "enum": ["smoke", "core", "exhaustive"] },
              "rationale": { "type": "string" },
              "evidence_ids": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "approach": { "type": "string" }
      }
    },
    "minimum_required_coverage": {
      "description": "Minimum required risk/requirement coverage contract. New advisories should emit structured items; legacy string arrays are accepted for one compatibility cycle.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "required": ["id", "key", "required"],
              "properties": {
                "id": { "type": "string", "pattern": "^MRC-[A-Z0-9-]+-\\d+$" },
                "key": { "type": "string" },
                "category": { "type": "string", "enum": ["api", "e2e", "e2e_if_enabled", "negative", "data_integrity"] },
                "required": { "type": "boolean" },
                "layer": { "type": "string", "enum": ["api", "e2e", "both"] },
                "enabled_when": { "type": "string" },
                "target": {
                  "type": "object",
                  "properties": {
                    "endpoint": { "type": "string" },
                    "handler": { "type": "string" },
                    "source_files": { "type": "array", "items": { "type": "string" } }
                  },
                  "additionalProperties": true
                },
                "advisory_refs": { "type": "array", "items": { "type": "string" } },
                "acceptance": { "type": "string" }
              },
              "additionalProperties": true
            }
          ]
        }
      }
    },
    "open_questions_for_case_design": {
      "description": "Per-pitfall assertion-intent questions ONLY. Each item must trace to a discovered code pitfall (evidence_ids) and ask whether to assert the known-bug behavior, the ideal behavior, or ignore it. Macro scope/data/layer/approach questions belong in test_strategy, not here.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "pitfall_ref", "maps_to_clarifying_categories"],
        "properties": {
          "id": { "type": "string", "pattern": "^OQ-\\d+$" },
          "question": { "type": "string" },
          "pitfall_ref": {
            "description": "Evidence or priority-hint/watchlist id this question traces to, e.g. an SC-* source-code evidence id or PH-*/WL-* item id.",
            "type": "string"
          },
          "maps_to_clarifying_categories": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "success_assertions",
                "exception_scenarios",
                "out_of_scope"
              ]
            }
          },
          "options": {
            "type": "array",
            "items": { "type": "string" }
          },
          "status": {
            "description": "Open-question lifecycle status. Legacy advisories may omit this; new advisories should set it explicitly.",
            "type": "string",
            "enum": ["unanswered", "answered", "deferred"],
            "default": "unanswered"
          },
          "assertion_intent": {
            "description": "Structured decision captured from the user's answer. null until answered.",
            "oneOf": [
              { "type": "string", "enum": ["assert_known_bug", "assert_ideal", "ignore", "undecided"] },
              { "type": "null" }
            ],
            "default": null
          },
          "answer": {
            "description": "Legacy answer field. Prefer answer_text for newly answered questions.",
            "oneOf": [
              { "type": "string" },
              { "type": "null" }
            ],
            "default": null
          },
          "answer_text": {
            "description": "Human answer text for interactive answers. auto_default answers may omit this.",
            "oneOf": [
              { "type": "string" },
              { "type": "null" }
            ],
            "default": null
          },
          "answered_via": {
            "description": "Which phase or mechanism resolved the question. null if not yet answered.",
            "oneOf": [
              { "type": "string", "enum": ["explore", "auto_default", "aa-intake"] },
              { "type": "null" }
            ],
            "default": null
          },
          "deferred_reason": {
            "description": "Required when status is deferred.",
            "oneOf": [
              { "type": "string" },
              { "type": "null" }
            ],
            "default": null
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
