+import asyncio
+import time
+from datetime import datetime, timezone
+from uuid import uuid4
+
+import httpx
+from fastapi import HTTPException
+
+from app.models.shipping import ShippingOrder
+from app.schemas.shipping import CarrierReceipt, CarrierRejection, ShippingCreate
+from app.settings import settings
+
+PARCEL_FIELDS = ("recipient", "phone", "address", "item_name", "quantity")
+
+
+def event(action, status, message, attempts=0):
+    return {
+        "at": datetime.now(timezone.utc).isoformat(),
+        "action": action,
+        "status": status,
+        "message": message,
+        "attempts": attempts,
+    }
+
+
+async def data(order):
+    result = await order.to_dict(exclude_fields=["operation_token", "lease_until", "client_ref"])
+    result["busy"] = order.lease_until > time.time()
+    return result
+
+
+async def get_order(order_id):
+    order = await ShippingOrder.get_or_none(id=order_id)
+    if order is None:
+        raise HTTPException(404, "发货单不存在")
+    return order
+
+
+async def create_order(body: ShippingCreate):
+    values = body.model_dump(mode="json")
+    order, _ = await ShippingOrder.get_or_create(
+        client_ref=values["client_ref"],
+        defaults={
+            **{key: values[key] for key in PARCEL_FIELDS},
+            "order_no": f"SP-{uuid4().hex}",
+            "events": [event("create", "DRAFT", "发货单已创建，尚未申请运单")],
+        },
+    )
+    if any(getattr(order, key) != values[key] for key in PARCEL_FIELDS):
+        raise HTTPException(409, "创建标识已用于其他发货内容，请重新新建")
+    return await data(order)
+
+
+async def contact_carrier(order, action):
+    if not settings.CARRIER_TOKEN:
+        return "UNKNOWN", None, "物流服务未配置，请联系管理员后查询或重试", 0
+    headers = {"Authorization": f"Bearer {settings.CARRIER_TOKEN}", "Idempotency-Key": order.order_no}
+    payload = {"reference": order.order_no, **{key: getattr(order, key) for key in PARCEL_FIELDS}}
+    async with httpx.AsyncClient(
+        base_url=str(settings.CARRIER_URL), timeout=settings.CARRIER_TIMEOUT, trust_env=False, follow_redirects=False
+    ) as client:
+        for attempt in range(1, 4):
+            try:
+                if action == "submit":
+                    response = await client.post("/shipments", json=payload, headers=headers)
+                else:
+                    response = await client.get(f"/shipments/{order.order_no}", headers=headers)
+            except httpx.DecodingError:
+                return "UNKNOWN", None, "物流响应无法解码，请查询结果或联系管理员", attempt
+            except httpx.TransportError:
+                response = None
+            if response is None or response.status_code >= 500:
+                if attempt < 3:
+                    await asyncio.sleep(0.05 * 2 ** (attempt - 1))
+                    continue
+                return "UNKNOWN", None, "物流服务未确认结果，请查询结果或使用原单重试", attempt
+            if response.status_code == 200:
+                try:
+                    receipt = CarrierReceipt.model_validate(response.json())
+                    if receipt.reference != order.order_no:
+                        raise ValueError("reference mismatch")
+                    return "ACCEPTED", receipt.waybill_no, "物流已受理，运单号已确认", attempt
+                except ValueError:
+                    return "UNKNOWN", None, "物流响应格式或业务单号不符，请联系管理员", attempt
+            if action == "submit" and response.status_code == 422:
+                try:
+                    rejection = CarrierRejection.model_validate(response.json())
+                    return "REJECTED", None, rejection.message, attempt
+                except ValueError:
+                    pass
+            if action == "reconcile" and response.status_code == 404:
+                return "UNKNOWN", None, "物流暂未查到运单，可使用原单重新申请", attempt
+            return "UNKNOWN", None, f"物流服务返回异常状态 {response.status_code}，请联系管理员", attempt
+
+
+async def operate(order_id, action):
+    order = await get_order(order_id)
+    if order.status in ("ACCEPTED", "REJECTED") or (action == "reconcile" and order.status == "DRAFT"):
+        return await data(order)
+    token = uuid4().hex
+    # A DB lease survives process restarts and serializes requests across workers.
+    claimed = await ShippingOrder.filter(id=order.id, status=order.status, lease_until__lte=time.time()).update(
+        status="PENDING",
+        operation_token=token,
+        lease_until=time.time() + 30,
+        reason="正在联系物流服务；若处理被中断，请稍后查询结果",
+    )
+    if not claimed:
+        return await data(await get_order(order.id))
+    try:
+        state, waybill, reason, attempts = await asyncio.wait_for(contact_carrier(order, action), timeout=15)
+    except TimeoutError:
+        state, waybill, reason, attempts = "UNKNOWN", None, "处理超过时限，请查询物流结果", 0
+    await ShippingOrder.filter(id=order.id, operation_token=token).update(
+        status=state,
+        waybill_no=waybill,
+        reason=reason,
+        operation_token=None,
+        lease_until=0,
+        events=[*order.events, event(action, state, reason, attempts)],
+    )
+    return await data(await get_order(order.id))
