+from typing import Literal
+
+from fastapi import APIRouter, Query
+
+from app.controllers.shipping import create_order, data, get_order, operate
+from app.models.shipping import ShippingOrder
+from app.schemas.base import Success, SuccessExtra
+from app.schemas.shipping import ShippingCreate
+
+router = APIRouter(tags=["发货管理"])
+
+
+@router.get("/list", summary="查看发货单列表")
+async def list_orders(
+    page: int = Query(1, ge=1),
+    page_size: int = Query(10, ge=1, le=100),
+    status: Literal["DRAFT", "PENDING", "UNKNOWN", "ACCEPTED", "REJECTED"] | None = None,
+    order_no: str = Query("", max_length=64),
+):
+    query = ShippingOrder.filter(order_no__contains=order_no)
+    if status:
+        query = query.filter(status=status)
+    total = await query.count()
+    rows = await query.order_by("-id").offset((page - 1) * page_size).limit(page_size)
+    return SuccessExtra(data=[await data(row) for row in rows], total=total, page=page, page_size=page_size)
+
+
+@router.get("/get", summary="查看发货单详情")
+async def detail(id: int = Query(..., gt=0)):
+    return Success(data=await data(await get_order(id)))
+
+
+@router.post("/create", summary="创建发货单")
+async def create(body: ShippingCreate):
+    return Success(data=await create_order(body))
+
+
+@router.post("/submit", summary="申请物流运单")
+async def submit(id: int = Query(..., gt=0)):
+    return Success(data=await operate(id, "submit"))
+
+
+@router.post("/reconcile", summary="查询物流受理结果")
+async def reconcile(id: int = Query(..., gt=0)):
+    return Success(data=await operate(id, "reconcile"))
