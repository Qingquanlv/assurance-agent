+from typing import Literal
+from uuid import UUID
+
+from pydantic import BaseModel, ConfigDict, Field, StrictInt
+
+
+class ShippingCreate(BaseModel):
+    model_config = ConfigDict(extra="forbid", str_strip_whitespace=True)
+    client_ref: UUID
+    recipient: str = Field(min_length=1, max_length=80)
+    phone: str = Field(pattern=r"^\+?[0-9 -]{7,24}$")
+    address: str = Field(min_length=5, max_length=300)
+    item_name: str = Field(min_length=1, max_length=100)
+    quantity: StrictInt = Field(ge=1, le=1000)
+
+
+class CarrierReceipt(BaseModel):
+    model_config = ConfigDict(extra="forbid", strict=True, str_strip_whitespace=True)
+    reference: str = Field(min_length=1, max_length=64)
+    waybill_no: str = Field(min_length=1, max_length=64)
+    status: Literal["ACCEPTED"]
+
+
+class CarrierRejection(BaseModel):
+    model_config = ConfigDict(extra="forbid", strict=True, str_strip_whitespace=True)
+    code: Literal["QUANTITY_LIMIT", "ADDRESS_UNSUPPORTED"]
+    message: str = Field(min_length=1, max_length=300)
