+from app.models.admin import Api, Menu, Role
+from app.schemas.menus import MenuType
+
+
+async def init_shipping():
+    # Incremental setup for existing databases; never reset the existing menu tree.
+    menu, created = await Menu.get_or_create(
+        path="/shipping",
+        parent_id=0,
+        defaults={
+            "name": "发货管理",
+            "menu_type": MenuType.MENU,
+            "component": "/shipping",
+            "icon": "carbon:delivery",
+            "order": 2,
+            "keepalive": False,
+        },
+    )
+    for method, suffix, summary in (
+        ("GET", "list", "查看发货单列表"),
+        ("GET", "get", "查看发货单详情"),
+        ("POST", "create", "创建发货单"),
+        ("POST", "submit", "申请物流运单"),
+        ("POST", "reconcile", "查询物流受理结果"),
+    ):
+        api, api_created = await Api.get_or_create(
+            path=f"/api/v1/shipping/{suffix}", method=method, defaults={"summary": summary, "tags": "发货管理"}
+        )
+        for role_name in ["管理员", "普通用户"] if method == "GET" else ["管理员"]:
+            role = await Role.get_or_none(name=role_name)
+            if role:
+                if created:
+                    await role.menus.add(menu)
+                # Do not restore an explicitly revoked grant on every restart.
+                if api_created or created:
+                    await role.apis.add(api)
