+<script setup>
+import { h, onMounted, onUnmounted, ref, resolveDirective, withDirectives } from 'vue'
+import { NButton, NTag, NSpace } from 'naive-ui'
+import CommonPage from '@/components/page/CommonPage.vue'
+import CrudTable from '@/components/table/CrudTable.vue'
+import CrudModal from '@/components/table/CrudModal.vue'
+import QueryBarItem from '@/components/query-bar/QueryBarItem.vue'
+import api from '@/api'
+
+defineOptions({ name: '发货管理' })
+
+const table = ref(null)
+const filters = ref({})
+const createVisible = ref(false)
+const detailVisible = ref(false)
+const saving = ref(false)
+const activeId = ref(null)
+const selected = ref(null)
+const form = ref({})
+const formRef = ref(null)
+const vPermission = resolveDirective('permission')
+const labels = {
+  DRAFT: '待申请',
+  PENDING: '处理中',
+  UNKNOWN: '待确认',
+  ACCEPTED: '已受理',
+  REJECTED: '已拒绝',
+}
+const colors = {
+  DRAFT: 'default',
+  PENDING: 'info',
+  UNKNOWN: 'warning',
+  ACCEPTED: 'success',
+  REJECTED: 'error',
+}
+const statuses = Object.entries(labels).map(([value, label]) => ({ value, label }))
+const rules = {
+  recipient: { required: true, message: '请输入收件人', trigger: 'blur' },
+  phone: {
+    required: true,
+    pattern: /^\+?[0-9 -]{7,24}$/,
+    message: '请输入有效联系电话',
+    trigger: 'blur',
+  },
+  address: { required: true, min: 5, message: '请填写至少 5 个字符的详细地址', trigger: 'blur' },
+  item_name: { required: true, message: '请输入物品名称', trigger: 'blur' },
+  quantity: {
+    type: 'number',
+    required: true,
+    min: 1,
+    max: 1000,
+    message: '数量应为 1～1000',
+    trigger: 'change',
+  },
+}
+
+function openCreate() {
+  form.value = {
+    client_ref: crypto.randomUUID(),
+    recipient: '',
+    phone: '',
+    address: '',
+    item_name: '',
+    quantity: 1,
+  }
+  createVisible.value = true
+}
+
+async function createOrder() {
+  if (saving.value) return
+  try {
+    await formRef.value?.validate()
+  } catch {
+    return
+  }
+  saving.value = true
+  try {
+    const { data } = await api.createShipping(form.value)
+    createVisible.value = false
+    selected.value = data
+    detailVisible.value = true
+    window.$message?.success('发货单已创建，可申请物流运单')
+    table.value?.handleSearch()
+  } catch {
+    // The shared HTTP interceptor shows errors; retain the form and creation key.
+  } finally {
+    saving.value = false
+  }
+}
+
+async function showDetails(row) {
+  try {
+    const { data } = await api.getShipping(row.id)
+    selected.value = data
+    detailVisible.value = true
+  } catch {
+    // Shared interceptor displays the error.
+  }
+}
+
+async function operate(row, action) {
+  if (activeId.value !== null) return
+  activeId.value = row.id
+  try {
+    const { data } = await (action === 'submit'
+      ? api.submitShipping(row.id)
+      : api.reconcileShipping(row.id))
+    selected.value = data
+    detailVisible.value = true
+    if (data.status === 'ACCEPTED') window.$message?.success(data.reason)
+    else if (data.status === 'REJECTED') window.$message?.error(data.reason)
+    else window.$message?.warning(data.reason)
+  } catch {
+    // A browser timeout does not prove carrier failure. Read persisted state again.
+    if (selected.value?.id === row.id) {
+      try {
+        selected.value = (await api.getShipping(row.id)).data
+      } catch {
+        /* interceptor */
+      }
+    }
+  } finally {
+    activeId.value = null
+    table.value?.handleSearch()
+  }
+}
+
+function actionButton(row, action, text) {
+  return withDirectives(
+    h(
+      NButton,
+      {
+        size: 'small',
+        type: action === 'submit' ? 'primary' : 'default',
+        loading: activeId.value === row.id,
+        disabled: activeId.value !== null || row.busy,
+        onClick: () => operate(row, action),
+      },
+      { default: () => text }
+    ),
+    [[vPermission, `post/api/v1/shipping/${action}`]]
+  )
+}
+
+const columns = [
+  { title: '发货单号', key: 'order_no', width: 230, ellipsis: { tooltip: true } },
+  { title: '收件人', key: 'recipient', width: 110 },
+  { title: '物品', key: 'item_name', width: 140 },
+  { title: '数量', key: 'quantity', width: 70 },
+  {
+    title: '状态',
+    key: 'status',
+    width: 100,
+    render: (row) =>
+      h(NTag, { type: colors[row.status], bordered: false }, { default: () => labels[row.status] }),
+  },
+  {
+    title: '运单号',
+    key: 'waybill_no',
+    width: 220,
+    ellipsis: { tooltip: true },
+    render: (row) => row.waybill_no || '—',
+  },
+  {
+    title: '处理说明',
+    key: 'reason',
+    width: 220,
+    ellipsis: { tooltip: true },
+    render: (row) => row.reason || '等待申请物流运单',
+  },
+  {
+    title: '操作',
+    key: 'actions',
+    width: 260,
+    fixed: 'right',
+    render(row) {
+      const buttons = [
+        h(NButton, { size: 'small', onClick: () => showDetails(row) }, { default: () => '详情' }),
+      ]
+      if (['DRAFT', 'UNKNOWN', 'PENDING'].includes(row.status)) {
+        buttons.push(actionButton(row, 'submit', row.status === 'DRAFT' ? '申请运单' : '重新申请'))
+        if (row.status !== 'DRAFT') buttons.push(actionButton(row, 'reconcile', '查询结果'))
+      }
+      return h(NSpace, { size: 'small' }, { default: () => buttons })
+    },
+  },
+]
+
+let poll
+onMounted(() => {
+  table.value?.handleSearch()
+  poll = setInterval(async () => {
+    if (table.value?.tableData?.some((row) => row.status === 'PENDING')) table.value.refresh()
+    if (detailVisible.value && selected.value?.status === 'PENDING') {
+      try {
+        selected.value = (await api.getShipping(selected.value.id)).data
+      } catch {
+        /* interceptor */
+      }
+    }
+  }, 3000)
+})
+onUnmounted(() => clearInterval(poll))
+</script>
+
+<template>
+  <CommonPage title="发货管理">
+    <template #action>
+      <n-button v-permission="'post/api/v1/shipping/create'" type="primary" @click="openCreate"
+        >新建发货单</n-button
+      >
+    </template>
+    <n-alert type="info" :show-icon="true" class="mb-20">
+      创建发货单后申请物流运单。“待确认”表示尚未确认受理结果，请先查询；重新申请会沿用原业务单号。
+    </n-alert>
+    <CrudTable
+      ref="table"
+      v-model:query-items="filters"
+      :columns="columns"
+      :get-data="api.getShippingList"
+      :scroll-x="1450"
+    >
+      <template #queryBar>
+        <QueryBarItem label="发货单号"
+          ><n-input
+            v-model:value="filters.order_no"
+            clearable
+            placeholder="输入发货单号"
+            @keypress.enter="table?.handleSearch()"
+        /></QueryBarItem>
+        <QueryBarItem label="状态"
+          ><n-select
+            v-model:value="filters.status"
+            :options="statuses"
+            clearable
+            placeholder="全部状态"
+            class="w-160"
+        /></QueryBarItem>
+      </template>
+    </CrudTable>
+
+    <CrudModal
+      v-model:visible="createVisible"
+      title="新建发货单"
+      :loading="saving"
+      @save="createOrder"
+    >
+      <n-form ref="formRef" :model="form" :rules="rules" label-placement="left" :label-width="90">
+        <n-form-item label="收件人" path="recipient"
+          ><n-input v-model:value="form.recipient" :maxlength="80" placeholder="收件人姓名"
+        /></n-form-item>
+        <n-form-item label="联系电话" path="phone"
+          ><n-input v-model:value="form.phone" :maxlength="24" placeholder="手机或固定电话"
+        /></n-form-item>
+        <n-form-item label="详细地址" path="address"
+          ><n-input
+            v-model:value="form.address"
+            type="textarea"
+            :maxlength="300"
+            placeholder="省市区、街道及门牌号"
+        /></n-form-item>
+        <n-form-item label="物品名称" path="item_name"
+          ><n-input v-model:value="form.item_name" :maxlength="100" placeholder="例如：办公文具"
