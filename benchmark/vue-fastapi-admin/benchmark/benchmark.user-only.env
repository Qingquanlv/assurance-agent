# benchmark.user-only.env — single-item override of benchmark.env.
# Runs ONLY RET-user-management with the same driver/loop settings.
# Invoke with: BENCHMARK_ENV=benchmark/benchmark.user-only.env ./benchmark/run-workflow-loop-cursor.sh

# --- Single benchmark item ---
BENCHMARK_ITEMS=(
  "RET-user-management:requirements/user-management.md"
)

# --- GraphRuntime driver parameters ---
RUN_MODE="full"
RUN_TESTS="true"
FORCE_CONTINUE="false"
TEST_TYPES="api,e2e,fuzz,performance"
MAX_HEALING_ATTEMPTS="3"
DRIVER_ENTRYPOINT="full"

# --- Loop stages ---
DO_ARCHIVE="true"
RETRO_ID=""
RETRO_DRY_RUN="false"
CLEAN_ARTIFACTS="true"
CLEAN_TARGETS="qa/cases qa/changes"

# Benchmark Eval Metrics off for a targeted single-item rerun.
DO_BENCHMARK_EVAL="false"

# --- Cursor path ---
CURSOR_MODEL="cursor-grok-4.5-high-fast"
CURSOR_MAX_WORKFLOW_ATTEMPTS="3"
CURSOR_OUTPUT_FORMAT="stream-json"

# --- Timeouts ---
STEP_TIMEOUT="5400"
STATUS_POLL_INTERVAL="120"
