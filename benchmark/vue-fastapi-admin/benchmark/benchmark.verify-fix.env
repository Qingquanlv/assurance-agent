# benchmark.verify-fix.env — re-run the three items that failed on framework
# grounds (dept: fixer-join all_active crash, now fixed; role/menu: transient
# network / agent miss) to verify the planner.py fixer-join fix and get clean
# results.
# Invoke with: BENCHMARK_ENV=benchmark/benchmark.verify-fix.env ./benchmark/run-workflow-loop-cursor.sh

BENCHMARK_ITEMS=(
  "RET-dept-management:requirements/dept-management.md"
  "RET-role-management:requirements/role-management.md"
  "RET-menu-management:requirements/menu-management.md"
)

# --- GraphRuntime driver parameters (mirror benchmark.env) ---
RUN_MODE="full"
RUN_TESTS="true"
FORCE_CONTINUE="false"
TEST_TYPES="api,e2e,fuzz,performance"
MAX_HEALING_ATTEMPTS="3"
DRIVER_ENTRYPOINT="full"

# --- Loop stages ---
DO_ARCHIVE="true"
DO_NIGHTLY_COLLECT="false"
DO_RETRO="false"
DO_RETRO_PROPOSALS="false"
CLEAN_ARTIFACTS="false"

# --- Cursor path ---
CURSOR_MODEL="cursor-grok-4.5-high-fast"
CURSOR_MAX_WORKFLOW_ATTEMPTS="3"
CURSOR_AGENT_FORCE="true"
CURSOR_OUTPUT_FORMAT="stream-json"

# --- Timeouts ---
STEP_TIMEOUT="5400"
STATUS_POLL_INTERVAL="120"
