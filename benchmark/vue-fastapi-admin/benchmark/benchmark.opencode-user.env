# benchmark.opencode-user.env — single item from the 5-item suite via OpenCode.
# Invoke with:
#   BENCHMARK_ENV=benchmark/benchmark.opencode-user.env ./benchmark/run-workflow-loop.sh

BENCHMARK_ITEMS=(
  "RET-user-management:requirements/user-management.md"
)

# --- GraphRuntime driver parameters ---
RUN_MODE="full"
RUN_TESTS="true"
FORCE_CONTINUE="false"
TEST_TYPES="api,e2e,fuzz,performance"
MAX_HEALING_ATTEMPTS="3"
DRIVER_ENTRYPOINT="full"

# --- Loop stages (bounded single-item; preserve prior changes/memory) ---
DO_ARCHIVE="true"
DO_NIGHTLY_COLLECT="false"
CLEAN_ARTIFACTS="false"
DO_BENCHMARK_EVAL="false"

# --- OpenCode adapter path ---
DRIVER_ADAPTER="opencode"
OPENCODE_SERVER="http://127.0.0.1:4096"
# Empty enables execution.model_routing; non-empty is a deliberate global override.
OPENCODE_MODEL=""
OPENCODE_MAX_WORKFLOW_ATTEMPTS="3"

# --- Timeouts ---
# Full user-item runs routinely exceed 90m once specialty codegen starts.
STEP_TIMEOUT="14400"
