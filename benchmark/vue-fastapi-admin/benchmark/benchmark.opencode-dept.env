# benchmark.opencode-dept.env — first end-to-end validation of the OpenCode
# adapter path (run-workflow-loop.sh). Single item, no artifact wipe, no nightly
# collect, so it is a clean, bounded smoke of the opencode driver → GraphRuntime.
# Invoke with:
#   BENCHMARK_ENV=benchmark/benchmark.opencode-dept.env ./benchmark/run-workflow-loop.sh

BENCHMARK_ITEMS=(
  "RET-dept-management:requirements/dept-management.md"
)

# --- GraphRuntime driver parameters ---
RUN_MODE="full"
RUN_TESTS="true"
FORCE_CONTINUE="false"
TEST_TYPES="api,e2e,fuzz,performance"
MAX_HEALING_ATTEMPTS="3"
DRIVER_ENTRYPOINT="full"

# --- Loop stages (keep it a bounded single-item smoke) ---
DO_ARCHIVE="true"
DO_NIGHTLY_COLLECT="false"
DO_RETRO="false"
DO_RETRO_PROPOSALS="false"
CLEAN_ARTIFACTS="false"

# --- OpenCode adapter path ---
# OPENCODE_MODEL MUST be a valid, authenticated model. Leaving it empty makes the
# adapter omit the model field so the server resolves its own default, which via
# the oh-my-openagent plugin (~/.config/opencode/oh-my-openagent.json) resolves to
# the invalid "anthropic/glm-5.2" (ProviderModelNotFoundError -> agent produces no
# output -> invalid_output at the explore node). Pin the user's configured default.
DRIVER_ADAPTER="opencode"
OPENCODE_SERVER="http://127.0.0.1:4096"
OPENCODE_MODEL="anthropic/deepseek-v4-flash"
OPENCODE_MAX_WORKFLOW_ATTEMPTS="3"

# --- Timeouts ---
STEP_TIMEOUT="5400"
