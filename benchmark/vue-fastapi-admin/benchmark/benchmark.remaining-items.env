# benchmark.remaining-items.env — run the four benchmark.env items not yet
# covered by tonight's RET-user-management smoke runs.
# Invoke with: BENCHMARK_ENV=benchmark/benchmark.remaining-items.env ./benchmark/run-workflow-loop-cursor.sh

BENCHMARK_ITEMS=(
  "RET-dept-management:requirements/dept-management.md"
  "RET-api-management:requirements/api-management.md"
  "RET-role-management:requirements/role-management.md"
  "RET-menu-management:requirements/menu-management.md"
)

# --- GraphRuntime driver parameters (mirror benchmark.env) ---
RUN_MODE="full"
RUN_TESTS="true"
FORCE_CONTINUE="false"
TEST_TYPES="api,e2e,fuzz,performance"
MAX_HEALING_ATTEMPTS="3"
DRIVER_ENTRYPOINT="full"

# --- Loop stages ---
DO_ARCHIVE="true"
DO_NIGHTLY_COLLECT="true"
DO_RETRO="false"
DO_RETRO_PROPOSALS="true"
RETRO_SINCE_DAYS="7"
CLEAN_ARTIFACTS="true"
CLEAN_TARGETS="qa/cases qa/changes"

# --- Cursor path ---
CURSOR_MODEL="cursor-grok-4.5-high-fast"
CURSOR_MAX_WORKFLOW_ATTEMPTS="3"
CURSOR_AGENT_FORCE="true"
CURSOR_OUTPUT_FORMAT="stream-json"

# --- Timeouts ---
STEP_TIMEOUT="5400"
STATUS_POLL_INTERVAL="120"
