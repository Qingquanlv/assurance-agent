# benchmark.dept-only.env — single-item override of benchmark.env.
# Runs ONLY RET-dept-management (the item that hit the node_skipped ledger
# conflict) and exercises the archive + retro workflow entrypoints.
# Invoke with: BENCHMARK_ENV=benchmark/benchmark.dept-only.env ./benchmark/run-workflow-loop-cursor.sh

# --- Single benchmark item ---
BENCHMARK_ITEMS=(
  "RET-dept-management:requirements/dept-management.md"
)

# --- GraphRuntime driver parameters ---
RUN_MODE="full"
RUN_TESTS="true"
FORCE_CONTINUE="false"
TEST_TYPES="api,e2e,fuzz,performance"
MAX_HEALING_ATTEMPTS="3"
DRIVER_ENTRYPOINT="full"

# --- Loop stages: both new entrypoints on so this run covers them ---
DO_ARCHIVE="true"
USE_WORKFLOW_ARCHIVE="true"
ARCHIVE_ENTRYPOINT="archive"
DO_NIGHTLY_COLLECT="true"        # Retro closed loop (collect → propose → reconcile)
USE_WORKFLOW_RETRO="true"
RETRO_ENTRYPOINT="retro"
RETRO_ID=""
RETRO_LAST="10"
RETRO_MIN_EVIDENCE="2"
RETRO_DRY_RUN="false"
CLEAN_ARTIFACTS="true"
CLEAN_TARGETS="qa/cases qa/changes"

# Deterministic eval regression gate off for a targeted single-item rerun.
DO_EVAL_REGRESSION="false"

# --- Cursor path ---
CURSOR_MODEL="cursor-grok-4.5-high-fast"
CURSOR_MAX_WORKFLOW_ATTEMPTS="3"
CURSOR_AGENT_FORCE="true"
CURSOR_OUTPUT_FORMAT="stream-json"

# --- Timeouts ---
STEP_TIMEOUT="5400"
STATUS_POLL_INTERVAL="120"
