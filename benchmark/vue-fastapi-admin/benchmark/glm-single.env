# Focused GLM regression for the FactBaseline permission boundary.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/benchmark.env"

BENCHMARK_ITEMS=(
  "RET-api-management:requirements/api-management.md"
)
OPENCODE_MODEL="anthropic/glm-5.2"
CLEAN_ARTIFACTS="false"
DO_ARCHIVE="false"
RETRO_DRY_RUN="true"
DO_BENCHMARK_EVAL="false"
