# benchmark/benchmark.env — configuration for run-workflow-loop.sh and
# run-workflow-loop-cursor.sh. Every value can also be overridden by exporting
# the same env var before invoking the script (env wins over this file).

# --- Fixed benchmark items (regression re-run) ---
# Format: one "base_id:requirement_file" per line inside the array.
# The requirement_file path is relative to the benchmark/ dir (or absolute).
BENCHMARK_ITEMS=(
  "RET-dept-management:requirements/dept-management.md"
  "RET-user-management:requirements/user-management.md"
  "RET-api-management:requirements/api-management.md"
  "RET-role-management:requirements/role-management.md"
  "RET-menu-management:requirements/menu-management.md"
)

# --- GraphRuntime driver parameters (both scripts) ---
RUN_MODE="full"          # full | api-only | e2e-only | ...
RUN_TESTS="true"         # execute tests via operation:run-tests after codegen
FORCE_CONTINUE="false"   # schema param; keep false for honest gates
TEST_TYPES="api,e2e,fuzz,performance"     # layers passed to aa workflow run --params
MAX_HEALING_ATTEMPTS="3"
DRIVER_ENTRYPOINT="full"      # full | execute

# --- Loop stages (shared) ---
DO_ARCHIVE="true"                # after each completed change: archive stage
USE_WORKFLOW_ARCHIVE="true"      # true → aa workflow run --entrypoint archive; false → legacy cursor prompt
ARCHIVE_ENTRYPOINT="archive"
RETRO_ID=""                      # empty → retro-<RUNSTAMP>-cursor
RETRO_DRY_RUN="false"            # collect-only; skip propose/reconcile
DO_BENCHMARK_EVAL="true"          # collect deterministic golden-fixture metrics; informational only
BENCHMARK_EVAL_SUITES="workflow-run,classification-unit,safety-lite,eval-smoke,case-generation,workflow-case,workflow-api-codegen,workflow-e2e-codegen,workflow-fuzz-codegen,workflow-performance-codegen,workflow-full"
DO_TRACE_VERIFY="${DO_TRACE_VERIFY:-true}"  # persist trace/verify JSON; verify must pass benchmark gate
DO_SPECIALTY_REPORT="${DO_SPECIALTY_REPORT:-true}"  # freeze capability/policy replay + trace/evidence detail
CLEAN_ARTIFACTS="true"           # wipe qa/cases + qa/changes once at loop start (keep archive/retro/tests)
CLEAN_TARGETS="qa/cases qa/changes"
MAX_COVERAGE_REPAIR_ATTEMPTS="1" # bounded in-change metrics shortfall repair loop

# --- OpenCode path (run-workflow-loop.sh) ---
# Empty OPENCODE_MODEL uses opencode's configured default model.
DRIVER_ADAPTER="opencode"        # opencode | headless
OPENCODE_SERVER="http://127.0.0.1:4096"
OPENCODE_MODEL=""
OPENCODE_MAX_WORKFLOW_ATTEMPTS="3"

# --- Cursor path (run-workflow-loop-cursor.sh) ---
# Always uses --adapter headless with cursor-agent as --agent-cmd.
CURSOR_MODEL="cursor-grok-4.5-high-fast"
CURSOR_MAX_WORKFLOW_ATTEMPTS="3"
CURSOR_OUTPUT_FORMAT="stream-json"

# --- Timeouts ---
# Per driver/agent step wall-clock cap (seconds).
# OpenCode: timeout/gtimeout if present.
# Cursor: run_with_hard_timeout.py (+ bash dual kill / status poll).
STEP_TIMEOUT="5400"
# Cursor only: poll aa status this often while a driver run is live, so a
# lingering process group can be stopped once terminal.kind is already set.
STATUS_POLL_INTERVAL="120"
